#lang racket/base

(define (inorder tree)
  (define (walk node k)
    (if (null? node)
        (k)
        (walk (cadr node)
              (lambda ()
                (cons (car node)
                      (walk (caddr node) k))))))
  (walk tree (lambda () '())))

(define (print-inorder tree)
  (display (inorder tree))
  (newline))

(define (preorder tree)
  (define (walk node k)
    (if (null? node)
        (k)
        (cons (car node)
              (walk (cadr node)
                    (lambda ()
                      (walk (caddr node) k))))))
  (walk tree (lambda () '())))
